{
  "name": "esp32-blocklab",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "default": "./dist-lib/index.js"
    },
    "./core": {
      "types": "./dist-lib/core.d.ts",
      "default": "./dist-lib/core.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "node scripts/build-lib.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:lib": "node scripts/lib-smoke.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "slides": "tsx scripts/export-slides.ts"
  },
  "dependencies": {
    "@blockly/field-colour": "^13.3.0",
    "@blockly/field-multilineinput": "^13.3.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/python": "^1.1.19",
    "@tailwindcss/vite": "^4.3.3",
    "blockly": "^13.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "lucide": "^1.56.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.5",
    "react-router": "^7.18.4",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "description": "ESP32 블록랩 — 체험판(GitHub Pages)과 허브에 심는 라이브러리(dist-lib)"
}
